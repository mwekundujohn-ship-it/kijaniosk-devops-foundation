# Monday baseline: single stage, root user, build tools shipped in the image.
FROM node:18.20.4-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY tsconfig.json ./
COPY src ./src
RUN npm run build

ENV NODE_ENV=production \
    PORT=3001

EXPOSE 3001

CMD ["node", "dist/index.js"]
