# ---------- build stage ----------
FROM node:18.20.4-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY tsconfig.json ./
COPY src ./src
RUN npm run build

# ---------- runtime stage ----------
FROM alpine:3.22

ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION} \
    NODE_ENV=production \
    PORT=3001

RUN addgroup -S -g 10001 kijani \
    && adduser -S -u 10001 -G kijani kijani \
    && apk add --no-cache nodejs

WORKDIR /app

COPY --from=build --chown=kijani:kijani /app/dist ./dist
COPY --from=build --chown=kijani:kijani /app/package.json ./package.json

USER kijani

EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/health >/dev/null 2>&1 || exit 1

CMD ["node", "dist/index.js"]
